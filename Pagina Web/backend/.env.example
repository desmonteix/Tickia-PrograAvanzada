# --- Database Configuration (Supabase PostgreSQL) ---
DATABASE_URL="postgresql+psycopg://postgres.XXXX:password@aws-0-REGION.pooler.supabase.com:6543/postgres"

# --- Supabase API ---
SUPABASE_URL="https://XXXX.supabase.co"
SUPABASE_KEY="eyJhbGci..."

# --- Security ---
SECRET_KEY="GENERATED_SECRET_KEY_FOR_JWT_HERE"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Pagos y Escrow (Culqi Sandbox) ---
CULQI_PUBLIC_KEY="pk_test_XXXX"
CULQI_PRIVATE_KEY="sk_test_XXXX"

# --- Optional future integrations (not used by current login/signup) ---
# Reserved for SMS/OTP phone verification; no Twilio calls are implemented yet.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Reserved for future transactional email; currently unused.
RESEND_API_KEY=

# --- Production gates ---
ENVIRONMENT=development
PAYMENT_ENABLED=false
SETTLEMENT_ENABLED=false
FRONTEND_PROD_URL=https://tickia.lat,https://www.tickia.lat
COOKIE_SAMESITE=lax
# Generate a distinct random URL-safe secret (32-128 characters) in your secret manager.
PROXY_SHARED_SECRET=
QR_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY_BEFORE_DEPLOYMENT

# Tests only: TICKIA_LOAD_ENV=0 prevents loading local credentials.
# TEST_POSTGRES_URL must point to a dedicated test database.
