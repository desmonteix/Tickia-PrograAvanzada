digraph G { graph [bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.50", splines=polyline]; node [fontname="Arial"]; edge [fontname="Arial", fontsize=10, color="#577188", arrowsize=.7];
graph [rankdir=TB];
commerce [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#183B56"><FONT FACE="Arial" COLOR="white" POINT-SIZE="13"><B>«modulo Python»<BR/>commerce</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">quote_cart(), checkout()</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">history(), advance()</FONT></TD></TR></TABLE>>];
catalog [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#183B56"><FONT FACE="Arial" COLOR="white" POINT-SIZE="13"><B>«modulo Python»<BR/>catalog</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">list_products(), product_detail()</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">summary(), table_rows()</FONT></TD></TR></TABLE>>];
analytics [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#183B56"><FONT FACE="Arial" COLOR="white" POINT-SIZE="13"><B>«modulo Python»<BR/>analytics</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">load_frames(), build_bundle()</FONT></TD></TR></TABLE>>];
ProductRepository [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#183B56"><FONT FACE="Arial" COLOR="white" POINT-SIZE="13"><B>ProductRepository</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+db: Connection</FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#E9EFF4"></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+search(viewer, filtros, pagina)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+detail(id, viewer), variants(id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+latest_reviews(id), latest_questions(id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+has_review(), received()</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+categories(), districts(), couriers()</FONT></TD></TR></TABLE>>];
AnalyticsRepository [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#183B56"><FONT FACE="Arial" COLOR="white" POINT-SIZE="13"><B>AnalyticsRepository</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+db: Connection</FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#E9EFF4"></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+orders(), clients(), items()</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+shipments(), reviews(), vendors()</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+frame(sql): DataFrame</FONT></TD></TR></TABLE>>];
CatalogRepository [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#183B56"><FONT FACE="Arial" COLOR="white" POINT-SIZE="13"><B>CatalogRepository</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+db: Connection</FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#E9EFF4"></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+variants(identifiers)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+valid_coupon(code)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+courier(id), district(id)</FONT></TD></TR></TABLE>>];
OrderRepository [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#183B56"><FONT FACE="Arial" COLOR="white" POINT-SIZE="13"><B>OrderRepository</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+db: Connection</FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#E9EFF4"></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+find_by_request(user, request)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+receipt_records(ids)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+accessible(user, order)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+history(user, seller, page)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+locked_state(id), advance(id, state)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+confirm(engine, args) {static}</FONT></TD></TR></TABLE>>];
Connection [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#183B56"><FONT FACE="Arial" COLOR="white" POINT-SIZE="13"><B>«SQLAlchemy»<BR/>Connection</B></FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#E9EFF4"></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+execute(statement, params)</FONT></TD></TR></TABLE>>];
Engine [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#183B56"><FONT FACE="Arial" COLOR="white" POINT-SIZE="13"><B>«SQLAlchemy»<BR/>Engine</B></FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#E9EFF4"></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+begin(), connect()</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+raw_connection()</FONT></TD></TR></TABLE>>];
commerce -> CatalogRepository [style=dashed,label="usa"]; commerce -> OrderRepository [style=dashed,label="usa"];
catalog -> ProductRepository [style=dashed,label="usa"]; analytics -> AnalyticsRepository [style=dashed,label="usa"];
ProductRepository -> Connection [label="db inyectada"]; AnalyticsRepository -> Connection [label="read_sql"];
CatalogRepository -> Connection [label="db inyectada"]; OrderRepository -> Connection [label="db inyectada"]; OrderRepository -> Engine [label="confirmacion atomica"];
}