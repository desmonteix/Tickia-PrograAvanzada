digraph G { graph [bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.50", splines=polyline]; node [fontname="Arial"]; edge [fontname="Arial", fontsize=10, color="#577188", arrowsize=.7];
graph [rankdir=TB,ranksep=.55];
OrderBuilder [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#183B56"><FONT FACE="Arial" COLOR="white" POINT-SIZE="13"><B>OrderBuilder</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">-_items: dict</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">-_coupon: str | None</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">-_shipping: tuple | None</FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#E9EFF4"></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+add_item(id, quantity, price)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+with_coupon(code, percentage)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+shipping(strategy, base, department)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+build(): OrderDraft</FONT></TD></TR></TABLE>>];
OrderDraft [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#183B56"><FONT FACE="Arial" COLOR="white" POINT-SIZE="13"><B>«dataclass inmutable»<BR/>OrderDraft</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+items: tuple[OrderItem, ...]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+subtotal, discount: Decimal</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+shipping_cost, total: Decimal</FONT></TD></TR></TABLE>>];
OrderItem [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#183B56"><FONT FACE="Arial" COLOR="white" POINT-SIZE="13"><B>«dataclass inmutable»<BR/>OrderItem</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+variant_id: int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+quantity: int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+unit_price: Decimal</FONT></TD></TR></TABLE>>];
PriceComponent [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#183B56"><FONT FACE="Arial" COLOR="white" POINT-SIZE="13"><B>«abstracta»<BR/>PriceComponent</B></FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#E9EFF4"></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+total(): Decimal</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+discounts(): tuple</FONT></TD></TR></TABLE>>];
BasePrice [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#183B56"><FONT FACE="Arial" COLOR="white" POINT-SIZE="13"><B>BasePrice</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+amount: Decimal</FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#E9EFF4"></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+total(): Decimal</FONT></TD></TR></TABLE>>];
PercentageDiscount [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#183B56"><FONT FACE="Arial" COLOR="white" POINT-SIZE="13"><B>PercentageDiscount</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+wrapped: PriceComponent</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+percentage: Decimal</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+label: str</FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#E9EFF4"></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+total(): Decimal</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+discounts(): tuple</FONT></TD></TR></TABLE>>];
ShippingStrategy [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#183B56"><FONT FACE="Arial" COLOR="white" POINT-SIZE="13"><B>«abstracta»<BR/>ShippingStrategy</B></FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#E9EFF4"></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+calculate(base, department, units)</FONT></TD></TR></TABLE>>];
StandardShipping [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#183B56"><FONT FACE="Arial" COLOR="white" POINT-SIZE="13"><B>StandardShipping</B></FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#E9EFF4"></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+calculate(...): Decimal</FONT></TD></TR></TABLE>>];
ExpressShipping [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#183B56"><FONT FACE="Arial" COLOR="white" POINT-SIZE="13"><B>ExpressShipping</B></FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#E9EFF4"></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+calculate(...): Decimal</FONT></TD></TR></TABLE>>];
EconomyShipping [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#183B56"><FONT FACE="Arial" COLOR="white" POINT-SIZE="13"><B>EconomyShipping</B></FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#E9EFF4"></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+calculate(...): Decimal</FONT></TD></TR></TABLE>>];
OrderBuilder -> OrderDraft [style=dashed,label="«crea»"]; OrderDraft -> OrderItem [dir=both,arrowtail=odiamond,arrowhead=none,label="items 1..*"];
OrderBuilder -> ShippingStrategy [label="configura"]; OrderBuilder -> PriceComponent [style=dashed,label="cotiza"];
BasePrice -> PriceComponent [arrowhead=empty]; PercentageDiscount -> PriceComponent [arrowhead=empty];
PercentageDiscount -> PriceComponent [dir=both,arrowtail=odiamond,arrowhead=none,label="wrapped 1",constraint=false];
StandardShipping -> ShippingStrategy [arrowhead=empty];
ExpressShipping -> ShippingStrategy [arrowhead=empty];
EconomyShipping -> ShippingStrategy [arrowhead=empty];
}