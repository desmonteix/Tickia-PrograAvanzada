digraph G { graph [bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.50", splines=polyline]; node [fontname="Arial"]; edge [fontname="Arial", fontsize=10, color="#577188", arrowsize=.7];
graph [rankdir=TB,ranksep=.55];
OrderContext [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#183B56"><FONT FACE="Arial" COLOR="white" POINT-SIZE="13"><B>OrderContext</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+state: OrderState</FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#E9EFF4"></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+transition(target): OrderState</FONT></TD></TR></TABLE>>];
OrderState [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#183B56"><FONT FACE="Arial" COLOR="white" POINT-SIZE="13"><B>«clase base»<BR/>OrderState</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+name: str</FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#E9EFF4"></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+transition(next_name)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+pay(), ship(), deliver()</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+from_name(name): OrderState</FONT></TD></TR></TABLE>>];
PendingState [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#183B56"><FONT FACE="Arial" COLOR="white" POINT-SIZE="13"><B>PendingState</B></FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#E9EFF4"></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+pay(): PaidState</FONT></TD></TR></TABLE>>];
PaidState [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#183B56"><FONT FACE="Arial" COLOR="white" POINT-SIZE="13"><B>PaidState</B></FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#E9EFF4"></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+ship(): ShippedState</FONT></TD></TR></TABLE>>];
ShippedState [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#183B56"><FONT FACE="Arial" COLOR="white" POINT-SIZE="13"><B>ShippedState</B></FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#E9EFF4"></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">+deliver(): DeliveredState</FONT></TD></TR></TABLE>>];
DeliveredState [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#183B56"><FONT FACE="Arial" COLOR="white" POINT-SIZE="13"><B>DeliveredState</B></FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#E9EFF4"></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">Sin transiciones permitidas</FONT></TD></TR></TABLE>>];
CancelledState [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#183B56"><FONT FACE="Arial" COLOR="white" POINT-SIZE="13"><B>CancelledState</B></FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#E9EFF4"></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="11">Estado historico terminal</FONT></TD></TR></TABLE>>];
OrderContext -> OrderState [dir=both,arrowtail=diamond,arrowhead=none,label="estado actual 1"];
PendingState -> OrderState [arrowhead=empty];
PaidState -> OrderState [arrowhead=empty];
ShippedState -> OrderState [arrowhead=empty];
DeliveredState -> OrderState [arrowhead=empty];
CancelledState -> OrderState [arrowhead=empty];
}